@@ -0,0 +1,21 @@
+//go:build !darwin && !linux
+
+package control
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestUnsupportedOwnerLockFailsClosed(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "owner.lock")
+	f, err := acquireOwnerLock(path)
+	if f != nil || err == nil || !strings.Contains(err.Error(), "Linux/macOS") {
+		t.Fatalf("unsupported owner must fail closed: file=%v err=%v", f, err)
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatalf("unsupported owner created lock file: %v", err)
+	}
+}
diff --git a/internal/control/lock_unix.go b/internal/control/lock_unix.go
new file mode 100644
index 0000000..8e4727f
--- /dev/null
+++ b/internal/control/lock_unix.go
@@ -0,0 +1,20 @@
+//go:build darwin || linux
+
+package control
+
+import (
+	"os"
+	"syscall"
+)
+
+func acquireOwnerLock(path string) (*os.File, error) {
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	if err = syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		f.Close()
+		return nil, err
+	}
+	return f, nil
+}
